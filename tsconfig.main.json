{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist/main",
    "sourceMap": false,
    "declaration": false,
    "removeComments": true
  },
  "include": ["src/main.ts", "src/preload.ts", "src/core/**/*", "src/shared/**/*"],
  "exclude": ["node_modules", "dist", "release", "src/**/*.test.ts", "src/renderer/**/*"]
}
