{
  "name": "whatsapp-scraping-tool",
  "productName": "WhatsApp Number Checker",
  "version": "2.0.1",
  "description": "Desktop app that checks a list of phone numbers against the WhatsApp Data API: which are on WhatsApp, which are business accounts, with CSV, Excel and JSON export. Open source, resumable, your key stays on your computer.",
  "main": "dist/main/main.js",
  "homepage": "https://whatsapp.checkleaked.cc/tools/bulk-checker-app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eduair94/whatsapp-scraping-tool.git"
  },
  "bugs": {
    "url": "https://github.com/eduair94/whatsapp-scraping-tool/issues"
  },
  "author": {
    "name": "Eduardo Airaudo",
    "url": "https://github.com/eduair94"
  },
  "license": "MIT",
  "private": true,
  "keywords": [
    "whatsapp",
    "whatsapp-checker",
    "bulk-checker",
    "number-validator",
    "phone-numbers",
    "electron",
    "desktop-app",
    "react",
    "typescript",
    "csv-export"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "node scripts/clean.mjs main && tsc --project tsconfig.main.json",
    "build:renderer": "webpack --mode production",
    "start": "npm run build && electron .",
    "demo": "npm run build && electron . --demo",
    "dev": "npm run build:main && webpack --mode development && electron .",
    "typecheck": "tsc --project tsconfig.main.json --noEmit && tsc --project tsconfig.renderer.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs --dev",
    "smoke:dist": "node scripts/smoke.mjs",
    "screenshots": "npm run build && electron . --screenshots=docs/images",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "google-libphonenumber": "^3.2.42",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@fontsource-variable/figtree": "5.2.8",
    "@resvg/resvg-js": "2.6.2",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "css-loader": "^7.1.2",
    "electron": "45.2.0",
    "electron-builder": "26.18.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "prettier": "^3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
  },
  "build": {
    "appId": "io.github.eduair94.whatsappnumberchecker",
    "productName": "WhatsApp Number Checker",
    "copyright": "Copyright © 2026 Eduardo Airaudo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "build/icon.png",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "afterPack": "./build/after-pack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "whatsapp-number-checker-windows-setup.${ext}"
    },
    "portable": {
      "artifactName": "whatsapp-number-checker-windows-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "artifactName": "whatsapp-number-checker-mac-${arch}.${ext}"
    },
    "linux": {
      "executableName": "whatsapp-number-checker",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Eduardo Airaudo <eduair94@users.noreply.github.com>",
      "synopsis": "Check which phone numbers of a list are on WhatsApp",
      "artifactName": "whatsapp-number-checker-linux-x64.${ext}"
    },
    "publish": null,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "deb": {
      "packageName": "whatsapp-number-checker"
    }
  }
}
